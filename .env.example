# Copy to .env and fill in real values. .env is gitignored.
#
# Used by docker-compose.yml (dev) and docker-compose.prod.yml (production).

# --- JWT ---
# Signing key for the .NET API (passed as Jwt__Key). Generate a strong one:
#   openssl rand -base64 48
# NOTE: changing this invalidates all previously issued tokens.
JWT_KEY=
JWT_ISSUER=MmcTaxiApi
JWT_AUDIENCE=MmcTaxiClient

# --- MySQL (production only) ---
# Used on the FIRST boot to create the database + app user. Use strong passwords.
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
MYSQL_DATABASE=mmc_taxi_db
MYSQL_USER=mmc

# --- Frontend (production only) ---
# Host port the frontend container listens on; your external reverse proxy
# (taxi.mmck.lk) forwards here.
APP_PORT=8080
